  "operation_class": "action",
  "label": "Send a test SMS campaign",
  "description": "Send a test SMS to a specified phone number to preview the campaign before sending it to all recipients. The phone number must belong to one of your existing contacts in your Brevo account and must not be blacklisted. The number should include the country code (e.g. 33689965433).",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "format": "int64",
          "type": "integer",
          "description": "Id of the SMS campaign"
        },
        "phoneNumber": {
          "description": "Mobile number of the recipient with the country code. This number **must belong to one of your contacts in Brevo account and must not be blacklisted**\n",
          "example": "33689965433",
          "type": "string"
        }
      },
      "required": [
        "campaignId"
      ]
    },
    "entity_refs": [
      {
        "input": "campaignId",
        "entity": "sms_campaign",
        "find_with": "brevo.sms_campaigns.get_sms_campaigns",
