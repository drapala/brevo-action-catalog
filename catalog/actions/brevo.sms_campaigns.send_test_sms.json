    "schema": null,
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/smsCampaigns/{campaignId}/sendTest",
      "auth": "header api-key",
      "params": {
        "campaignId": "path",
