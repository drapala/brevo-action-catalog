{
  "id": "brevo.sms_campaigns.update_sms_campaign_status",
  "product": "brevo",
  "area": "SMS Campaigns",
  "entity": "sms_campaign",
  "operation_class": "update",
  "label": "Update a campaign's status",
  "description": "Update the status of an SMS campaign, such as suspending, archiving, or replicating it. Available status values include suspended, archive, darchive, sent, queued, replicate, replicateTemplate, cancel, and draft. Note that the replicateTemplate status is only available for template type campaigns.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "format": "int64",
          "type": "integer",
          "description": "id of the campaign"
        },
        "status": {
          "description": "Note:- **replicateTemplate** status will be available **only for template type campaigns.**\n",
          "enum": [
            "suspended",
            "archive",
            "darchive",
            "sent",
            "queued",
            "replicate",
            "replicateTemplate",
            "cancel",
            "draft"
          ],
          "type": "string"
        }
      },
      "required": [
        "campaignId"
      ]
    },
    "entity_refs": [
      {
        "input": "campaignId",
        "entity": "sms_campaign",
        "find_with": "brevo.sms_campaigns.get_sms_campaigns",
        "create_with": "brevo.sms_campaigns.create_sms_campaign"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": null,
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "PUT",
      "url": "https://api.brevo.com/v3/smsCampaigns/{campaignId}/status",
      "auth": "header api-key",
      "params": {
        "campaignId": "path",
        "status": "body"
      },
      "success_status": [
        204
      ]
    }
  ],
  "preconditions": [],
  "postcondition": {
    "check_with": "brevo.sms_campaigns.get_sms_campaign",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.sms_campaigns.update_sms_campaign_status",
    "external_effect": "none",
    "idempotent": true,
    "requires_confirmation": false
  },
  "availability": {
    "free_plan": "unknown",
    "requires": []
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//smsCampaigns/{campaignId}/status/put (updateSmsCampaignStatus)"
    }
  ]
}
