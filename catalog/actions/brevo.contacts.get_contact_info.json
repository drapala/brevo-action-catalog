            "id": {
              "description": "ID of the contact for which you requested the details",
              "example": 32,
              "format": "int64",
              "type": "integer"
            },
            "listIds": {
              "items": {
                "description": "List(s) in which the contact is included",
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            },
