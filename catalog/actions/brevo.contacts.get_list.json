{
  "id": "brevo.contacts.get_list",
  "product": "brevo",
  "area": "Contacts",
  "entity": "list",
  "operation_class": "read",
  "label": "Get a list's details",
  "description": "Retrieve the details of a specific contact list by its ID, including its name, folder ID, creation date, subscriber counts, and campaign statistics. You can optionally filter campaign statistics by providing startDate and endDate parameters (both must be used together in YYYY-MM-DD format).",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "listId": {
          "format": "int64",
          "type": "integer",
          "description": "Id of the list"
        },
        "startDate": {
          "type": "string",
          "description": "**Mandatory if endDate is used**. Starting (urlencoded) UTC date-time (YYYY-MM-DDTHH:mm:ss.SSSZ) to aggregate the sent email campaigns for a specific list id. **Prefer to pass your timezone in date-time format for accurate result**"
        },
        "endDate": {
          "type": "string",
          "description": "**Mandatory if startDate is used**. Ending (urlencoded) UTC date-time (YYYY-MM-DDTHH:mm:ss.SSSZ) to aggregate the sent email campaigns for a specific list id. **Prefer to pass your timezone in date-time format for accurate result**"
        }
      },
      "required": [
        "listId"
      ]
    },
    "entity_refs": [
      {
        "input": "listId",
        "entity": "list",
        "find_with": "brevo.contacts.get_lists",
        "create_with": "brevo.contacts.create_list"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "allOf": [
        {
          "properties": {
            "id": {
              "description": "ID of the list",
              "example": 23,
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "description": "Name of the list",
              "example": "Magento Customers - EN",
              "type": "string"
            },
            "totalBlacklisted": {
              "description": "Number of blacklisted contacts in the list",
              "example": 13,
              "format": "int64",
              "type": "integer"
            },
            "totalSubscribers": {
              "description": "Number of contacts in the list",
              "example": 1776,
              "format": "int64",
              "type": "integer"
            },
            "uniqueSubscribers": {
              "description": "Number of unique contacts in the list",
              "example": 1789,
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "name",
            "totalBlacklisted",
            "totalSubscribers",
            "uniqueSubscribers"
