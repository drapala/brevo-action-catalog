              },
              "value": {
                "description": "Header value",
                "example": "v2",
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "maxRetries": {
          "description": "Maximum number of retry attempts for failed requests",
          "example": 3,
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "cache": {
          "description": "Whether to cache the feed response",
          "example": true,
