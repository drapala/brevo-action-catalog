{
  "id": "brevo.email_campaigns.email_export_recipients",
  "product": "brevo",
  "area": "Email Campaigns",
  "entity": "email_campaign",
  "operation_class": "action",
  "label": "Export the recipients of an email campaign",
  "description": "Export the recipients of a sent email campaign as an asynchronous process, filtered by recipient type (e.g. openers, clickers, hardBounces). The recipientsType field is required and determines which subset of recipients to export. An optional notifyURL webhook will be called once the export is complete, and the response returns a processId to track the export status.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "format": "int64",
          "type": "integer",
          "description": "Id of the campaign"
        },
        "notifyURL": {
          "description": "Webhook called once the export process is finished. For reference, https://help.brevo.com/hc/en-us/articles/360007666479",
          "example": "http://requestb.in/173lyyx1",
          "format": "url",
          "type": "string"
        },
        "recipientsType": {
          "description": "Type of recipients to export for a campaign",
          "enum": [
            "all",
            "nonClickers",
            "nonOpeners",
            "clickers",
            "openers",
            "softBounces",
            "hardBounces",
            "unsubscribed"
          ],
          "example": "openers",
          "type": "string"
        }
      },
      "required": [
        "campaignId",
        "recipientsType"
      ]
    },
    "entity_refs": [
      {
        "input": "campaignId",
        "entity": "email_campaign",
        "find_with": "brevo.email_campaigns.get_email_campaigns",
        "create_with": "brevo.email_campaigns.create_email_campaign"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "properties": {
        "processId": {
          "description": "Id of the process created",
          "example": 78,
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "processId"
      ],
      "type": "object"
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/emailCampaigns/{campaignId}/exportRecipients",
      "auth": "header api-key",
      "params": {
        "campaignId": "path",
        "notifyURL": "body",
        "recipientsType": "body"
      },
      "success_status": [
        202
      ]
    }
  ],
  "preconditions": [],
  "postcondition": null,
  "side_effects": {
    "reversible": false,
    "undo_with": null,
    "external_effect": "none",
    "idempotent": null,
    "requires_confirmation": true
  },
  "availability": {
    "free_plan": "unknown",
    "requires": []
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null,
    "notes": "Not run with real inputs. A call with inputs that cannot succeed returned HTTP 400, not a plan refusal ({\"code\": \"missing_parameter\", \"message\": \"Recipient type is missing\"}). Evidence: evidence/runs.jsonl#run=probe-gates-1793648157."
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//emailCampaigns/{campaignId}/exportRecipients/post (emailExportRecipients)"
    }
  ]
}
