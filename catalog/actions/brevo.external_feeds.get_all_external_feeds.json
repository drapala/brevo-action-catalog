          "description": "Can be used to filter records by search keyword on feed name"
        },
        "startDate": {
          "format": "date",
          "type": "string",
          "description": "Mandatory if `endDate` is used. Starting date (YYYY-MM-DD) from which\nyou want to fetch the list. Can be maximum 30 days older than current\ndate."
        },
        "endDate": {
          "format": "date",
          "type": "string",
          "description": "Mandatory if `startDate` is used. Ending date (YYYY-MM-DD) till which\nyou want to fetch the list. Maximum time period that can be selected is\none month."
        },
        "sort": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string",
          "description": "Sort the results in the ascending/descending order of record creation.\nDefault order is **descending** if `sort` is not passed."
        },
        "authType": {
          "enum": [
            "basic",
            "token",
            "noAuth"
          ],
          "type": "string",
          "description": "Filter the records by `authType` of the feed."
        },
        "limit": {
          "default": 50,
          "format": "int64",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
          "description": "Number of documents returned per page."
        },
        "offset": {
          "default": 0,
          "format": "int64",
          "type": "integer",
          "description": "Index of the first document on the page."
        }
      }
    },
    "entity_refs": [],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
