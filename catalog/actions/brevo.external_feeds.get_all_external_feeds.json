              "modifiedAt": {
                "description": "Feed last modification timestamp",
                "example": "2025-09-18T13:29:27.208Z",
                "format": "date-time",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "authType",
              "maxRetries",
              "cache",
              "createdAt",
              "modifiedAt"
            ],
            "type": "object"
          },
          "type": "array"
        }
