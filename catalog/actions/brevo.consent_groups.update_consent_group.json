{
  "id": "brevo.consent_groups.update_consent_group",
  "product": "brevo",
  "area": "ConsentGroups",
  "entity": "consent_group",
  "operation_class": "update",
  "label": "Update a consent group",
  "description": "Updates name, description, or signupMode of a consent group. At least one field must be provided. <Note>This endpoint is only available when the Consent Groups feature is enabled for your account.</Note>",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "ID of the consent group to update"
        },
        "name": {
          "type": "string",
          "description": "New name for the consent group (max 255 characters)"
        },
        "description": {
          "type": "string",
          "description": "New description (max 500 characters)"
        },
        "signupMode": {
          "type": "string",
          "enum": [
            "manual",
            "automatic"
          ],
          "description": "New signup mode"
        }
      },
      "required": [
        "id"
      ]
    },
    "entity_refs": [
      {
        "input": "id",
        "entity": "consent_group",
        "find_with": "brevo.consent_groups.get_consent_groups",
        "create_with": "brevo.consent_groups.create_consent_group"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "type": "object",
      "description": "A consent group representing a category of contact opt-in/opt-out preferences.",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Unique identifier for the consent group",
          "example": 1
        },
        "name": {
          "type": "string",
          "description": "Display name of the consent group",
          "example": "Newsletter EU"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the consent group",
          "example": "Consent group for EU newsletter subscribers"
        },
        "signupMode": {
          "type": "string",
          "enum": [
            "manual",
            "automatic"
          ],
          "description": "Controls how contacts are added to the group. `manual` — contacts are added explicitly via the API. `automatic` — contacts are added automatically at signup.",
          "example": "manual"
        },
        "contactsCount": {
          "type": "integer",
          "format": "int64",
          "description": "Number of contacts currently in this consent group",
          "example": 1234
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is a system-created default consent group",
          "example": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC date-time when the consent group was created (YYYY-MM-DDTHH:mm:ss.SSSZ)",
          "example": "2024-01-15T10:00:00Z"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC date-time when the consent group was last updated (YYYY-MM-DDTHH:mm:ss.SSSZ)",
          "example": "2024-06-01T08:30:00Z"
        }
      },
      "required": [
        "id",
        "name",
        "signupMode",
        "contactsCount",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "PUT",
      "url": "https://api.brevo.com/v3/contacts/consent-groups/{id}",
      "auth": "header api-key",
      "params": {
        "id": "path",
        "name": "body",
        "description": "body",
        "signupMode": "body"
      },
      "success_status": [
        200
      ]
    }
  ],
  "preconditions": [],
  "postcondition": {
    "check_with": "brevo.consent_groups.get_consent_group",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.consent_groups.update_consent_group",
    "external_effect": "none",
    "idempotent": true,
    "requires_confirmation": false
  },
  "availability": {
    "free_plan": "unknown",
    "requires": []
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//contacts/consent-groups/{id}/put (updateConsentGroup)"
    }
  ]
}
