{
  "id": "brevo.files.upload_file",
  "product": "brevo",
  "area": "Files",
  "entity": "file",
  "operation_class": "create",
  "label": "Upload a file",
  "description": "Upload a file and associate it with a contact, company, or deal. The file must be sent as multipart form data with a maximum size of 10 MB. You can optionally link the file to a specific entity by providing the corresponding entity ID.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string"
        },
        "contactId": {
          "format": "int64",
          "type": "integer"
        },
        "dealId": {
          "type": "string"
        },
        "file": {
          "description": "File data to create a file.",
          "format": "binary",
          "type": "string"
        }
      },
      "required": [
        "file"
      ]
    },
    "entity_refs": [],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "description": "File data that is uploaded",
      "properties": {
        "id": {
          "description": "Unique file id",
          "example": "61a5ce58c5d4795761045991",
          "type": "string"
        },
        "name": {
          "description": "Name of uploaded file",
          "example": "example.png",
          "type": "string"
        },
        "authorId": {
          "description": "Account id of user which created the file",
          "example": "61a5ce58c5d4795761045991",
          "type": "string"
        },
        "contactId": {
          "description": "Contact id of contact on which file is uploaded",
          "example": 1,
          "format": "int64",
          "type": "integer"
        },
        "dealId": {
          "description": "Deal id linked to a file",
          "example": "61a5ce58c5d4795761045991",
          "type": "string"
        },
        "companyId": {
          "description": "Company id linked to a file",
          "example": "61a5ce58c5d4795761045991",
          "type": "string"
        },
        "size": {
          "description": "Size of file in bytes",
          "example": 10,
          "format": "int64",
          "type": "integer"
        },
        "createdAt": {
          "description": "File created date/time",
          "example": "2017-05-01T17:05:03.000Z",
          "format": "date-time",
          "type": "string"
        }
      },
      "type": "object"
    },
    "produces_entity": {
      "entity": "file",
      "id_field": "id"
    }
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/crm/files",
      "auth": "header api-key",
      "params": {
        "companyId": "body",
        "contactId": "body",
        "dealId": "body",
        "file": "body"
      },
      "success_status": [
        201
      ]
    },
    {
      "kind": "ui_path",
      "ui_steps": [
        "Open https://app.brevo.com/contact/index/{contactId}",
        "Click 'More quick actions'",
        "Click 'File'",
        "Pick a file"
      ]
    }
  ],
  "preconditions": [],
  "postcondition": {
    "check_with": "brevo.files.download_file",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.files.delete_file",
    "external_effect": "none",
    "idempotent": null,
    "requires_confirmation": false
  },
  "availability": {
    "free_plan": "unknown",
    "requires": []
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null,
    "notes": "Not run with real inputs. A call with inputs that cannot succeed returned HTTP 400, not a plan refusal ({\"message\": \"parse multipart form: request Content-Type isn't multipart/form-data\"}). Evidence: evidence/runs.jsonl#run=probe-gates-1793648157."
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//crm/files/post"
    }
  ]
}
