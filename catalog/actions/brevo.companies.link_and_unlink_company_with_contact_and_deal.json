{
  "id": "brevo.companies.link_and_unlink_company_with_contact_and_deal",
  "product": "brevo",
  "area": "Companies",
  "entity": "company",
  "operation_class": "update",
  "label": "Link and Unlink company with contact and deal",
  "description": "Link or unlink contacts and deals with a specific company in a single request. You can simultaneously link new contacts/deals and unlink existing ones by providing the respective ID arrays in the request body.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "linkContactIds": {
          "description": "Contact ids for contacts to be linked with company",
          "example": [
            1,
            2,
            3
          ],
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "linkDealsIds": {
          "description": "Deal ids for deals to be linked with company",
          "example": [
            "61a5ce58c5d4795761045990",
            "61a5ce58c5d4795761045991",
            "61a5ce58c5d4795761045992"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unlinkContactIds": {
          "description": "Contact ids for contacts to be unlinked from company",
          "example": [
            4,
            5,
            6
          ],
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "unlinkDealsIds": {
          "description": "Deal ids for deals to be unlinked from company",
          "example": [
            "61a5ce58c5d4795761045994",
            "61a5ce58c5d479576104595",
            "61a5ce58c5d4795761045996"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id"
      ]
    },
    "entity_refs": [
      {
        "input": "id",
        "entity": "company",
        "find_with": "brevo.companies.get_all_companies",
        "create_with": "brevo.companies.create_company"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": null,
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "PATCH",
      "url": "https://api.brevo.com/v3/companies/link-unlink/{id}",
      "auth": "header api-key",
      "params": {
        "id": "path",
        "linkContactIds": "body",
        "linkDealsIds": "body",
        "unlinkContactIds": "body",
        "unlinkDealsIds": "body"
      },
      "success_status": [
        204
      ]
    },
    {
      "kind": "ui_path",
      "ui_steps": [
        "Open https://app.brevo.com/contact/index/{contactId}",
        "Click 'Add companies'",
        "Pick companies"
      ]
    },
    {
      "kind": "ui_path",
      "ui_steps": [
        "Open https://app.brevo.com/companies/detail/{companyId}",
        "Click 'Add contacts'",
        "Pick contacts"
      ]
    }
  ],
  "preconditions": [],
  "postcondition": {
    "check_with": "brevo.companies.get_company",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.companies.link_and_unlink_company_with_contact_and_deal",
    "external_effect": "none",
    "idempotent": null,
    "requires_confirmation": true
  },
  "availability": {
    "free_plan": "unknown",
    "requires": []
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//companies/link-unlink/{id}/patch"
    }
  ]
}
