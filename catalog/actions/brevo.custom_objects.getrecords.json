{
  "id": "brevo.custom_objects.getrecords",
  "product": "brevo",
  "area": "Custom Objects",
  "entity": "record",
  "operation_class": "read",
  "label": "Get the list of object records and total records count for an object.",
  "description": "<Note title=\"Enterprise access only\">Custom objects are only available to Enterprise plans. This feature is in beta. These are subject to change.</Note> This API retrieves a list of object records along with their associated records and provides the total count of records for the specified object. **Note**: Contact as object type is not supported in this endpoint.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "object_type": {
          "example": "vehicle",
          "type": "string",
          "description": "Object type for the records to retrieve. Must be a previously created custom object type. Contact as object type is not supported in this endpoint."
        },
        "limit": {
          "format": "int64",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer",
          "description": "Number of records returned per page"
        },
        "page_num": {
          "format": "int64",
          "minimum": 1,
          "type": "integer",
          "description": "Page number for pagination. It's used to fetch the object records on a provided page number. Must be a valid positive integer."
        },
        "sort": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string",
          "description": "Sort order, must be 'asc' or 'desc'. Default to 'desc' if not provided."
        },
        "association": {
          "enum": [
            "true",
            "false"
          ],
          "type": "string",
          "description": "Whether to include associations, must be 'true' or 'false'. Default to 'false' if not provided."
        }
      },
      "required": [
        "object_type",
        "limit",
        "page_num"
      ]
    },
    "entity_refs": [
      {
        "input": "object_type",
        "entity": "object_type",
        "find_with": null,
        "create_with": null
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "properties": {
        "count": {
          "description": "Total number of object records for an object type.",
          "example": 350,
          "format": "int64",
          "type": "integer"
        },
        "records": {
          "items": {
            "properties": {
              "associations": {
                "description": "List of associations for the object record. If association query param is true it will return 5 associated records per association.",
                "items": {
                  "oneOf": [
                    {
                      "properties": {
                        "object_type": {
                          "description": "Type of the associated object",
                          "example": "garage",
                          "type": "string"
                        },
                        "records": {
                          "items": {
                            "oneOf": [
                              {
                                "properties": {
                                  "identifiers": {
                                    "description": "Identifiers attached with the associated object record.",
                                    "properties": {
                                      "id": {
                                        "description": "Internal ID of the object record generated by Brevo",
                                        "example": 12345,
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              },
                              {
                                "properties": {
                                  "identifiers": {
                                    "description": "Identifiers attached with the associated object record.",
                                    "properties": {
                                      "id": {
                                        "description": "Internal ID of the object record generated by Brevo",
                                        "example": 45678,
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              }
                            ]
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "object_type": {
                          "description": "Type of the associated object",
                          "example": "insurance",
                          "type": "string"
                        },
                        "records": {
                          "items": {
                            "oneOf": [
                              {
                                "properties": {
                                  "identifiers": {
                                    "description": "Identifiers attached with the associated object record. Only includes the internal ID.",
                                    "properties": {
                                      "id": {
                                        "description": "Internal ID of the insurance object record generated by Brevo",
                                        "example": 98765,
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              },
                              {
                                "properties": {
                                  "identifiers": {
                                    "description": "Identifiers attached with the associated object record. Only includes the internal ID.",
                                    "properties": {
                                      "id": {
                                        "description": "Internal ID of the insurance object record generated by Brevo",
                                        "example": 87654,
                                        "type": "integer"
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              }
                            ]
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "attributes": {
                "description": "Key-value pairs of attribute data for the object record. Each key is the attribute **key** (e.g., `company_name`, `engine_type`), not the attribute label (e.g., \"Company Name\", \"Engine Type\"). Only attributes that already exist in the object schema will be present.\nFor `category` or `multiple_category` attributes, the value is the option **key** (not the option label or option ID).\n",
                "example": {
                  "make": "Toyota",
                  "model": "Corolla",
                  "color": "Black",
                  "year": 2020,
                  "engine_type": "hybrid"
                },
                "type": "object"
              },
              "createdAt": {
                "description": "Timestamp when the object record was created",
                "example": "2025-07-22T10:20:30Z",
                "format": "date-time",
                "type": "string"
              },
              "identifiers": {
                "description": "Identifiers for the object record. Supports `id` (singular, not `ids`) or `ext_id`.\n- `ext_id`: Your external system's identifier for this record.\n- `id`: Internal Brevo record ID.\n",
                "properties": {
                  "ext_id": {
                    "description": "External ID of the record in your system.",
                    "example": "507f1f77bc",
                    "type": "string"
                  },
                  "id": {
                    "description": "Internal ID of the object record generated by Brevo.",
                    "example": 16789,
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "updatedAt": {
                "description": "Timestamp when the object record was last updated",
                "example": "2025-07-22T10:20:30Z",
                "format": "date-time",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "GET",
      "url": "https://api.brevo.com/v3/objects/{object_type}/records",
      "auth": "header api-key",
      "params": {
        "object_type": "path",
        "limit": "query",
        "page_num": "query",
        "sort": "query",
        "association": "query"
      },
      "success_status": [
        200
      ]
    }
  ],
  "preconditions": [
