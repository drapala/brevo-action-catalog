{
  "id": "brevo.ecommerce.create_product_alert",
  "product": "brevo",
  "area": "Ecommerce",
  "entity": "alert",
  "operation_class": "create",
  "label": "Create a product alert for a contact",
  "description": "Register a contact to receive an alert for a specific product event, such as `back_in_stock`. At least one contact identifier (`ext_id`, `email`, or `sms`) must be provided; when multiple are given, priority is `ext_id` > `email` > `sms`. Returns a `404` error if the product ID does not exist, and a `403` error if product alerts are not enabled for the account.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Product ID"
        },
        "type": {
          "enum": [
            "back_in_stock"
          ],
          "type": "string",
          "description": "Alert type"
        },
        "contactIdentifiers": {
          "properties": {
            "email": {
              "description": "Email address of the contact",
              "example": "elly@example.com",
              "format": "email",
              "type": "string"
            },
            "ext_id": {
              "description": "Contact ID in your system",
              "example": "ExternalId",
              "type": "string"
            },
            "sms": {
              "description": "Sms of the contact",
              "example": "+91xxxxxxxxxx",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ]
    },
    "entity_refs": [
      {
