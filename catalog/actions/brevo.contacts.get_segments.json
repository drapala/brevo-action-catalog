  "product": "brevo",
  "area": "Contacts",
  "entity": "segment",
  "operation_class": "read",
  "label": "Get all the segments",
  "description": "Retrieve all contact segments defined in your Brevo account with support for pagination and sorting. Results default to 10 segments per page (maximum 50) sorted in descending order of creation. Each segment includes its ID, name, category name, and last update timestamp.",
