{
  "id": "brevo.consent_groups.get_consent_groups",
  "product": "brevo",
  "area": "ConsentGroups",
  "entity": "consent_group",
  "operation_class": "read",
  "label": "List all consent groups",
  "description": "Returns a paginated list of consent groups for the account. <Note>This endpoint is only available when the Consent Groups feature is enabled for your account. Returns `403` if the feature is not activated.</Note>",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "format": "int64",
          "default": 10,
          "maximum": 50,
          "minimum": 0,
          "description": "Maximum number of results to return (default 10, max 50)"
        },
        "offset": {
          "type": "integer",
          "format": "int64",
          "default": 0,
          "minimum": 0,
          "description": "Number of results to skip (default 0)"
        },
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Filter by consent group ID"
        },
        "name": {
          "type": "string",
          "description": "Filter by name (case-insensitive partial match)"
        },
        "signupMode": {
          "type": "string",
          "enum": [
            "manual",
            "automatic"
          ],
          "description": "Filter by signup mode"
        }
      }
    },
    "entity_refs": [],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "type": "object",
      "description": "Paginated list of consent groups.",
      "properties": {
        "consentGroups": {
          "type": "array",
          "description": "List of consent groups matching the filter",
          "items": {
            "type": "object",
            "description": "A consent group representing a category of contact opt-in/opt-out preferences.",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "description": "Unique identifier for the consent group",
                "example": 1
              },
              "name": {
                "type": "string",
                "description": "Display name of the consent group",
                "example": "Newsletter EU"
              },
              "description": {
                "type": "string",
                "description": "Optional description of the consent group",
                "example": "Consent group for EU newsletter subscribers"
              },
              "signupMode": {
                "type": "string",
                "enum": [
                  "manual",
                  "automatic"
                ],
                "description": "Controls how contacts are added to the group. `manual` — contacts are added explicitly via the API. `automatic` — contacts are added automatically at signup.",
                "example": "manual"
              },
              "contactsCount": {
                "type": "integer",
                "format": "int64",
                "description": "Number of contacts currently in this consent group",
                "example": 1234
              },
              "isDefault": {
                "type": "boolean",
                "description": "Whether this is a system-created default consent group",
                "example": false
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "UTC date-time when the consent group was created (YYYY-MM-DDTHH:mm:ss.SSSZ)",
                "example": "2024-01-15T10:00:00Z"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "UTC date-time when the consent group was last updated (YYYY-MM-DDTHH:mm:ss.SSSZ)",
                "example": "2024-06-01T08:30:00Z"
              }
            },
            "required": [
              "id",
              "name",
              "signupMode",
              "contactsCount",
              "isDefault",
              "createdAt",
              "updatedAt"
            ]
          }
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "description": "Total number of consent groups matching the filter",
          "example": 5
        },
        "limit": {
          "type": "integer",
          "format": "int64",
          "description": "Maximum number of results returned",
          "example": 10
        },
        "offset": {
          "type": "integer",
          "format": "int64",
          "description": "Number of results skipped",
          "example": 0
        }
      },
      "required": [
        "consentGroups",
        "total",
        "limit",
        "offset"
      ]
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "GET",
      "url": "https://api.brevo.com/v3/contacts/consent-groups",
      "auth": "header api-key",
      "params": {
        "limit": "query",
        "offset": "query",
        "id": "query",
        "name": "query",
        "signupMode": "query"
      },
      "success_status": [
        200
      ]
    }
  ],
