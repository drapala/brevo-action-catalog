{
  "id": "brevo.coupons.create_coupons",
  "product": "brevo",
  "area": "Coupons",
  "entity": "coupon",
  "operation_class": "create",
  "label": "Create coupons for a coupon collection",
  "description": "Add coupons to an existing coupon collection. The `coupons` array must contain between 1 and 10,000 unique coupon code strings, all associated with the specified `collectionId`. Coupon creation is processed asynchronously and a `204` status is returned immediately upon acceptance. Returns a `404` error if the specified coupon collection does not exist.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "collectionId": {
          "description": "The id of the coupon collection for which the coupons will be created",
          "example": "23befbae-1505-47a8-bd27-e30ef739f32c",
          "format": "uuidv4",
          "type": "string"
        },
        "coupons": {
          "items": {
            "description": "Name of the coupon",
            "example": "Uf12AF",
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "collectionId",
        "coupons"
      ]
    },
    "entity_refs": [],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": null,
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/coupons",
      "auth": "header api-key",
      "params": {
        "collectionId": "body",
        "coupons": "body"
      },
      "success_status": [
        204
      ]
    }
  ],
