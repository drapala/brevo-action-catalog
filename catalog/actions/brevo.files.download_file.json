{
  "id": "brevo.files.download_file",
  "product": "brevo",
  "area": "Files",
  "entity": "file",
  "operation_class": "read",
  "label": "Download a file",
  "description": "Get a temporary download URL for a CRM file by its identifier. The returned URL is valid for 5 minutes only and provides direct access to the file content.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "File id to download."
        }
      },
      "required": [
        "id"
      ]
    },
    "entity_refs": [
      {
        "input": "id",
        "entity": "file",
        "find_with": "brevo.files.get_all_files",
        "create_with": "brevo.files.upload_file"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "description": "Downloadable file link",
      "properties": {
        "fileUrl": {
          "description": "A unique link to download the requested file.",
          "example": "https://storage.googleapis.com/brevo-app-crm.......-sample.pdf",
          "type": "string"
        }
      },
      "type": "object"
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "GET",
      "url": "https://api.brevo.com/v3/crm/files/{id}",
      "auth": "header api-key",
      "params": {
        "id": "path"
      },
      "success_status": [
        200
      ]
    }
  ],
