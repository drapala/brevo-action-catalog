          "type": "integer",
          "description": "Id of the webhook"
        }
      },
      "required": [
        "webhookId"
      ]
    },
    "entity_refs": [
      {
        "input": "webhookId",
        "entity": "webhook",
        "find_with": "brevo.webhooks.get_webhooks",
