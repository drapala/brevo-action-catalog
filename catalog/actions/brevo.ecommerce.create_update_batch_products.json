{
  "id": "brevo.ecommerce.create_update_batch_products",
  "product": "brevo",
  "area": "Ecommerce",
  "entity": "product",
  "operation_class": "create",
  "label": "Create products in batch",
  "description": "Create or update multiple ecommerce products in a single request. The `products` array accepts up to 100 product objects for creation (or up to 1000 when `updateEnabled` is `true` and the account has an increased limit). Each product requires a unique `id` and `name` (name is mandatory for creation only). When `updateEnabled` is `false`, all products are inserted as new; if any ID already exists, a `400` error is returned. When `updateEnabled` is `true`, existing products are updated and new ones are created via upsert. Duplicate IDs within the same request payload are rejected. The response r",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "products": {
          "description": "array of products objects",
          "items": {
            "properties": {
              "brand": {
                "description": "Brand of the product",
                "example": "Adidas",
                "type": "string",
                "maxLength": 128
              },
              "categories": {
                "description": "Category ID-s of the product",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "deletedAt": {
                "description": "UTC date-time (YYYY-MM-DDTHH:mm:ss.SSSZ) of the product deleted from the shop's database",
                "example": "2017-05-12T12:30:00Z",
                "type": "string"
              },
              "description": {
                "description": "Description of the product",
                "example": "Shoes for sports",
                "type": "string",
                "maxLength": 3000
              },
              "id": {
                "description": "Product ID for which you requested the details",
                "example": "P11",
                "format": "string",
                "type": "string"
              },
              "imageUrl": {
                "description": "Absolute URL to the cover image of the product",
                "example": "http://mydomain.com/product-absoulte-url/img.jpeg",
                "format": "string",
                "type": "string"
              },
              "isDeleted": {
                "description": "product deleted from the shop's database",
                "example": true,
                "type": "boolean"
              },
              "metaInfo": {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "description": "Meta data of product such as description, vendor, producer, stock level. The total characters of cumulative metaInfo shall not exceed **20000 characters**.",
                "example": {
                  "brand": "addidas",
                  "description": "Shoes for sports"
                },
                "type": "object"
              },
              "name": {
                "description": "**Mandatory in case of creation**. Name of the product, as displayed in the shop",
                "example": "Iphone 11",
                "type": "string"
              },
              "parentId": {
                "description": "Parent product id of the product",
                "format": "string",
                "type": "string"
              },
              "price": {
                "description": "Price of the product",
                "format": "float",
                "type": "number"
              },
              "alternativePrice": {
                "description": "Alternative price of the product",
                "format": "float",
                "type": "number"
              },
              "sku": {
                "description": "Product identifier from the shop",
                "format": "string",
                "type": "string"
              },
              "stock": {
                "description": "Current stock value of the product from the shop's database",
                "example": 100,
                "type": "number"
              },
              "url": {
                "description": "URL to the product",
                "example": "http://mydomain.com/product/electronics/product1",
                "format": "string",
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "updateEnabled": {
          "description": "Facilitate to update the existing products in the same request (updateEnabled = true)",
          "type": "boolean"
        }
      },
      "required": [
        "products"
      ]
    },
    "entity_refs": [],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": {
      "properties": {
        "createdCount": {
          "description": "Number of the new created products",
          "example": 7,
          "format": "int64",
          "type": "integer"
        },
        "updatedCount": {
          "description": "Number of the existing products updated",
          "example": 5,
          "format": "int64",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/products/batch",
      "auth": "header api-key",
      "params": {
        "products": "body",
        "updateEnabled": "body"
      },
      "success_status": [
        201
      ]
    }
  ],
  "preconditions": [
    "eCommerce app activated (needed before any call in this area)"
  ],
  "postcondition": {
    "check_with": "brevo.ecommerce.get_product_info",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": false,
    "undo_with": null,
    "external_effect": "none",
    "idempotent": null,
    "requires_confirmation": true
  },
  "availability": {
    "free_plan": "gated",
    "requires": [
      "eCommerce app activated"
    ],
    "evidence": "HTTP 403 on the free plan"
  },
  "verification": {
    "status": "gated",
    "route_kind": "documented_api",
    "checked_at": "2026-11-02T19:36:29+00:00",
    "evidence": "evidence/runs.jsonl#run=probe-gates-1793648157",
    "notes": "HTTP 403 to a call with inputs that cannot succeed: {\"message\": \"Your eCommerce section is not yet activated.\", \"code\": \"permission_denied\"}"
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//products/batch/post (createUpdateBatchProducts)"
    }
  ]
}
