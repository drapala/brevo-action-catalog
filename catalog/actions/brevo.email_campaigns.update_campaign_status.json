{
  "id": "brevo.email_campaigns.update_campaign_status",
  "product": "brevo",
  "area": "Email Campaigns",
  "entity": "email_campaign",
  "operation_class": "update",
  "label": "Update an email campaign status",
  "description": "Update the status of an email campaign, such as suspending, archiving, or replicating it. Available status values include suspended, archive, darchive, sent, queued, replicate, replicateTemplate, cancel, and draft. Note that the replicateTemplate status is only available for template type campaigns.",
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "campaignId": {
          "format": "int64",
          "type": "integer",
          "description": "Id of the campaign"
        },
        "status": {
          "description": "Note:- **replicateTemplate** status will be available **only for template type campaigns.**\n",
          "enum": [
            "suspended",
            "archive",
            "darchive",
            "sent",
            "queued",
            "replicate",
            "replicateTemplate",
            "cancel",
            "draft"
          ],
          "type": "string"
        }
      },
      "required": [
        "campaignId"
      ]
    },
    "entity_refs": [
      {
        "input": "campaignId",
        "entity": "email_campaign",
        "find_with": "brevo.email_campaigns.get_email_campaigns",
        "create_with": "brevo.email_campaigns.create_email_campaign"
      }
    ],
    "credential_ref": "brevo_api_key"
  },
  "outputs": {
    "schema": null,
    "produces_entity": null
  },
  "routes": [
    {
      "kind": "documented_api",
      "method": "PUT",
      "url": "https://api.brevo.com/v3/emailCampaigns/{campaignId}/status",
      "auth": "header api-key",
      "params": {
        "campaignId": "path",
        "status": "body"
      },
