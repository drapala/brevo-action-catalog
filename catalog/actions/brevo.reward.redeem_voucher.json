{
  "id": "brevo.reward.redeem_voucher",
  "product": "brevo",
  "area": "Reward",
  "entity": "reward",
  "operation_class": "create",
  "label": "Create redeem voucher request",
  "description": "Creates a request to redeem a voucher.",
  "inputs": {
