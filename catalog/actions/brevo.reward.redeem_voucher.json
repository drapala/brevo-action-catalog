  "routes": [
    {
      "kind": "documented_api",
      "method": "POST",
      "url": "https://api.brevo.com/v3/loyalty/offer/programs/{pid}/rewards/redeem",
      "auth": "header api-key",
      "params": {
        "pid": "path",
        "attributedRewardId": "body",
        "code": "body",
        "contactId": "body",
        "loyaltySubscriptionId": "body",
        "meta": "body",
        "order": "body",
        "rewardId": "body",
        "ttl": "body",
        "autoComplete": "body"
      },
      "success_status": [
        200
      ]
    }
  ],
  "preconditions": [
    "Loyalty app activated (needed before any call in this area)"
  ],
  "postcondition": {
    "check_with": "brevo.reward.get_reward_information",
    "assert": "the entity exists and its fields equal the inputs that were sent"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.reward.revoke_vouchers",
    "external_effect": "none",
    "idempotent": null,
    "requires_confirmation": false
  },
  "availability": {
    "free_plan": "unknown",
    "requires": [
      "Loyalty app activated"
    ]
  },
  "verification": {
    "status": "documented",
    "route_kind": null,
    "checked_at": null,
    "evidence": null
  },
  "sources": [
    {
      "kind": "openapi",
      "ref": "swagger_definition_v3.yml#/paths//loyalty/offer/programs/{pid}/rewards/redeem/post (redeemVoucher)"
    }
  ]
