{
  "id": "brevo.forms.create_form",
  "product": "brevo",
  "area": "Forms",
  "entity": "form",
  "operation_class": "create",
  "label": "Create a sign-up form",
  "description": "Create an embedded or full-page sign-up form. The form starts as a draft and collects nothing until it is set up and shared. The public API has no route for forms.",
  "intent_examples": [
    "make a newsletter sign-up form for the website"
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Form name, shown only inside Brevo"
        },
        "layout": {
          "type": "string",
          "enum": [
            "embedded",
            "popup"
          ],
          "default": "embedded",
          "description": "'popup' needs a paid plan (the option shows a Professional badge)"
        }
      }
    },
    "entity_refs": [],
    "credential_ref": "brevo_web_session"
  },
  "outputs": {
    "produces_entity": {
      "entity": "form",
      "id_field": "id"
    }
  },
  "routes": [
    {
      "kind": "ui_path",
      "ui_steps": [
        "Open https://app.brevo.com/contact/forms-app/subscription",
        "Click 'Create sign-up form'",
        "Keep 'Full page/embedded' selected",
        "Type the form name",
        "Click 'Create form'"
      ]
    },
    {
      "kind": "undocumented_api",
      "method": "POST",
      "url": "https://forms-api.brevo.com/forms-api/forms",
      "auth": "web session cookie",
      "params": {
        "name": "body"
      },
      "success_status": [
        201
      ]
    }
  ],
  "preconditions": [],
  "postcondition": {
    "check_with": "brevo.forms.list_forms",
    "assert": "the list holds a form with this id and name"
  },
  "side_effects": {
    "reversible": true,
    "undo_with": "brevo.forms.delete_form",
    "external_effect": "none",
    "idempotent": false,
    "requires_confirmation": false
  },
  "availability": {
    "free_plan": "available",
    "requires": []
  },
  "verification": {
    "status": "observed",
    "route_kind": "ui_path",
    "checked_at": "2026-11-02T16:26:32+00:00",
    "evidence": "evidence/ui-capture-2026-11-02-forms.json",
    "notes": "Created in the web app. The POST returned 201 with the new id, name and type 'subscription'. The request body was not captured."
  },
  "sources": [
    {
